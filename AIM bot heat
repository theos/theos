$ErrorActionPreference = "Stop"
$root = "aim"
New-Item -ItemType Directory -Force -Path "$root\src","$root\.github\workflows" | Out-Null
function W($p, $c) { [IO.File]::WriteAllText((Join-Path $root $p), $c, (New-Object Text.UTF8Encoding($false))) }

